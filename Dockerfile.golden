# syntax=docker/dockerfile:1.7

ARG RUBY_VERSION
ARG DEBIAN_VERSION=12-slim

# =============================================================================
# STAGE 1 — ruby-build (Build Layer)
# =============================================================================
FROM debian:${DEBIAN_VERSION} AS ruby-build

ARG RUBY_VERSION

RUN set -eux; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libffi-dev \
        libgdbm-dev \
        libncurses5-dev \
        libreadline-dev \
        libssl-dev \
        libyaml-dev \
        zlib1g-dev \
        pkg-config; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Clone ruby-build safely to compile the requested Ruby version
RUN git clone --depth 1 https://github.com/rbenv/ruby-build.git /tmp/ruby-build \
 && PREFIX=/usr/local /tmp/ruby-build/install.sh \
 && rm -rf /tmp/ruby-build

# Compile Ruby with explicit optimization flags (YJIT, clean docs)
ENV RUBY_CONFIGURE_OPTS="--enable-yjit --disable-install-doc"

RUN ruby-build ${RUBY_VERSION} /usr/local/ruby

# Strip the binary to reduce overall image size footprint
RUN strip --strip-unneeded /usr/local/ruby/bin/ruby || true

# =============================================================================
# STAGE 2 — base (Golden Runtime Layer)
# =============================================================================
FROM debian:${DEBIAN_VERSION} AS base

ARG RUBY_VERSION
ARG BUILD_DATE
ARG VCS_REF

LABEL org.opencontainers.image.title="rails-golden" \
      org.opencontainers.image.description="Hardened golden base for Ruby on Rails (ARM64)" \
      org.opencontainers.image.base.name="debian:12-slim" \
      org.opencontainers.image.version="${RUBY_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/<ORG>/<REPO>"

# Copy over only the isolated, standalone Ruby installation
COPY --from=ruby-build /usr/local/ruby /usr/local/ruby

# Standardized deployment environment paths
ENV BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    GEM_HOME="/usr/local/bundle" \
    PATH="/usr/local/bundle/bin:/usr/local/ruby/bin:$PATH"

RUN set -eux; \
    apt-get update -qq; \
    apt-get upgrade -y --no-install-recommends; \
    apt-get install -y --no-install-recommends \
        libjemalloc2 \
        libvips42 \
        libpq5 \
        libsqlite3-0 \
        libyaml-0-2 \
        libssl3 \
        zlib1g \
        ca-certificates \
        tzdata \
        curl; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/*

RUN groupadd --system --gid 1001 rails \
 && useradd  --system --uid 1001 --gid 1001 \
             --no-create-home --shell /sbin/nologin rails

WORKDIR /rails

RUN chown rails:rails /rails

USER 1001:1001
